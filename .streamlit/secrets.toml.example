# 复制为 .streamlit/secrets.toml 后填入自己的 key（该文件已被 .gitignore 忽略）
# Streamlit Community Cloud 部署时，把同样内容粘贴到 App settings → Secrets
DEEPSEEK_API_KEY = "sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# 以下为可选配置，保持默认即可
# DEEPSEEK_BASE_URL = "https://api.deepseek.com"
# DEEPSEEK_MODEL = "deepseek-chat"
# WHISPER_MODEL = "small"          # 语音识别模型：tiny / base / small / medium
# JOBPREP_DATA_DIR = "/data"       # 容器部署时把作答记录放到持久化目录
